name: Update Profile Cards

on:
  schedule:
    - cron: "0 */6 * * *"
  workflow_dispatch:
  push:
    paths: [".github/workflows/profile-cards.yml"]

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Generate cards
        env:
          GH_USER: ${{ github.repository_owner }}
          GH_TOKEN: ${{ secrets.PROFILE_TOKEN || secrets.GITHUB_TOKEN }}
        run: |
          python3 - << 'PYEOF'
          import os, json, html, urllib.request

          USER = os.environ.get("GH_USER", "amanyhisham")
          TOKEN = os.environ.get("GH_TOKEN", "")
          C, BG, TX = "#92400E", "#fafafa", "#333333"
          esc = html.escape

          QUERY = """
          query($u:String!){ user(login:$u){
            name
            contributionsCollection{ totalCommitContributions totalPullRequestReviewContributions }
            pullRequests(first:1){ totalCount }
            merged: pullRequests(first:1, states:MERGED){ totalCount }
            issues(first:1){ totalCount }
            repositoriesContributedTo(first:1, contributionTypes:[COMMIT,ISSUE,PULL_REQUEST,REPOSITORY]){ totalCount }
            repositoryDiscussions(first:1){ totalCount }
            repositoryDiscussionComments(first:1, onlyAnswers:true){ totalCount }
            repositories(first:100, ownerAffiliations:OWNER, isFork:false){ nodes{
              stargazers{ totalCount }
              languages(first:10, orderBy:{field:SIZE, direction:DESC}){ edges{ size node{ name color } } }
            } }
          } }"""

          def fetch():
              if os.environ.get("MOCK"):
                  return {"name": "amany hesham ^^", "contributionsCollection": {"totalCommitContributions": 181, "totalPullRequestReviewContributions": 0},
                          "pullRequests": {"totalCount": 0}, "merged": {"totalCount": 0}, "issues": {"totalCount": 0},
                          "repositoriesContributedTo": {"totalCount": 3}, "repositoryDiscussions": {"totalCount": 0},
                          "repositoryDiscussionComments": {"totalCount": 0},
                          "repositories": {"nodes": [{"stargazers": {"totalCount": 0}, "languages": {"edges": [
                              {"size": 465, "node": {"name": "HTML", "color": "#e34c26"}}, {"size": 179, "node": {"name": "C#", "color": "#178600"}},
                              {"size": 139, "node": {"name": "CSS", "color": "#563d7c"}}, {"size": 137, "node": {"name": "JavaScript", "color": "#f1e05a"}},
                              {"size": 66, "node": {"name": "TSQL", "color": "#e38c00"}}, {"size": 13, "node": {"name": "TypeScript", "color": "#3178c6"}}]}}]}}
              req = urllib.request.Request("https://api.github.com/graphql",
                  data=json.dumps({"query": QUERY, "variables": {"u": USER}}).encode(),
                  headers={"Authorization": f"bearer {TOKEN}", "Content-Type": "application/json", "User-Agent": "cards"})
              data = json.load(urllib.request.urlopen(req))
              if "errors" in data and "data" not in data:
                  raise SystemExit(data["errors"])
              return data["data"]["user"]

          def card(title, body):
              return (f'<svg xmlns="http://www.w3.org/2000/svg" width="360" height="180" viewBox="0 0 360 180" '
                      f'font-family="\'Segoe UI\',Ubuntu,Arial,sans-serif"><rect width="360" height="180" rx="6" fill="{BG}"/>'
                      f'<text x="20" y="32" font-size="15" font-weight="600" fill="{C}">{esc(title)}</text>{body}</svg>')

          def rows(items):
              out = []
              for i, (label, val) in enumerate(items):
                  y = 66 + i * 24
                  out.append(f'<circle cx="26" cy="{y-4}" r="3.5" fill="{C}"/>'
                             f'<text x="38" y="{y}" font-size="12" font-weight="600" fill="{TX}">{esc(label)}</text>'
                             f'<text x="340" y="{y}" font-size="12" font-weight="700" fill="{TX}" text-anchor="end">{val:,}</text>')
              return "".join(out)

          def langs(repos):
              tot, col = {}, {}
              for r in repos:
                  for e in r["languages"]["edges"]:
                      n = e["node"]["name"]
                      tot[n] = tot.get(n, 0) + e["size"]
                      col[n] = e["node"]["color"] or C
              top = sorted(tot.items(), key=lambda x: -x[1])[:6]
              s = sum(v for _, v in top) or 1
              bar, x = ['<clipPath id="c"><rect x="20" y="48" width="320" height="8" rx="4"/></clipPath><g clip-path="url(#c)">'], 20.0
              for n, v in top:
                  w = 320 * v / s
                  bar.append(f'<rect x="{x:.2f}" y="48" width="{w:.2f}" height="8" fill="{col[n]}"/>')
                  x += w
              bar.append("</g>")
              leg = []
              for i, (n, v) in enumerate(top):
                  cx, y = 26 + (i % 2) * 170, 88 + (i // 2) * 26
                  leg.append(f'<circle cx="{cx}" cy="{y-4}" r="4" fill="{col[n]}"/>'
                             f'<text x="{cx+10}" y="{y}" font-size="12" fill="{TX}">{esc(n)} {100*v/s:.2f}%</text>')
              return "".join(bar) + "".join(leg)

          u = fetch()
          cc = u["contributionsCollection"]
          stars = sum(r["stargazers"]["totalCount"] for r in u["repositories"]["nodes"])
          os.makedirs("assets", exist_ok=True)
          files = {
              "assets/stats.svg": card(f'{u["name"] or USER}\'s GitHub Stats', rows([
                  ("Total Stars Earned", stars), ("Total Commits (last year)", cc["totalCommitContributions"]),
                  ("Total PRs", u["pullRequests"]["totalCount"]), ("Total Issues", u["issues"]["totalCount"]),
                  ("Contributed to", u["repositoriesContributedTo"]["totalCount"])])),
              "assets/langs.svg": card("Most Used Languages", langs(u["repositories"]["nodes"])),
              "assets/extra.svg": card("More GitHub Stats", rows([
                  ("Total PRs Merged", u["merged"]["totalCount"]), ("Total PRs Reviewed", cc["totalPullRequestReviewContributions"]),
                  ("Discussions Started", u["repositoryDiscussions"]["totalCount"]),
                  ("Discussions Answered", u["repositoryDiscussionComments"]["totalCount"])])),
          }
          for p, svg in files.items():
              open(p, "w", encoding="utf-8").write(svg)
              print("written", p)

          PYEOF
      - name: Commit cards
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add assets/*.svg
          git diff --staged --quiet || git commit -m "Update profile cards"
          git push
